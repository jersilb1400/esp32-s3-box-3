# Ollama-primary hybrid (local LLM first, Claude API as fallback)
#   cp ollama-primary.env.example .env
#
# Default in .env.example is Claude API primary; use this to switch back.

BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000
BRIDGE_WEBSOCKET_URL=ws://192.168.1.50:8000/ws
BRIDGE_WEBSOCKET_TOKEN=local-dev-token
BRIDGE_WEBSOCKET_VERSION=1

LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=anthropic
LLM_ENABLE_FALLBACK=true

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=512

BRIDGE_SYSTEM_PROMPT="You are a concise assistant for an ESP32 voice device."

OPENCLAUDE_SKILL_URL=
OPENCLAUDE_API_KEY=

STT_PROVIDER=http
STT_HTTP_URL=http://127.0.0.1:9001/transcribe
STT_HTTP_API_KEY=
STT_TIMEOUT_S=30

TTS_PROVIDER=http
TTS_HTTP_URL=http://127.0.0.1:9002/synthesize
TTS_HTTP_API_KEY=
TTS_TIMEOUT_S=30
