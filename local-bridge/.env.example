# Copy this file to .env and fill in values:
#   cp .env.example .env

# ---- Bridge bind + advertised websocket (ESP32 must reach this IP) ----
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000
BRIDGE_WEBSOCKET_URL=ws://192.168.1.50:8000/ws
BRIDGE_WEBSOCKET_TOKEN=local-dev-token
BRIDGE_WEBSOCKET_VERSION=1

# ---- LLM provider routing (default: Claude API primary, Ollama optional fallback) ----
# For Ollama-primary profile, use ollama-primary.env.example: cp ollama-primary.env.example .env
LLM_PROVIDER=anthropic
LLM_FALLBACK_PROVIDER=ollama
# false = Anthropic only (avoids Ollama 404 if Ollama is not running). true = try Ollama if Claude fails; requires `ollama serve` + `ollama pull <OLLAMA_MODEL>`.
LLM_ENABLE_FALLBACK=false

# Anthropic (Claude API) — set your key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_YOUR_KEY
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=512

# Ollama — used when LLM_PROVIDER=ollama, or as fallback when enabled
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional bridge system prompt (must be quoted if it contains spaces)
BRIDGE_SYSTEM_PROMPT="You are a concise assistant for an ESP32 voice device."

# ---- Optional OpenClaude skill endpoint ----
OPENCLAUDE_SKILL_URL=
OPENCLAUDE_API_KEY=

# ---- STT / TTS (set both for full voice roundtrip) ----
STT_PROVIDER=http
STT_HTTP_URL=http://127.0.0.1:9001/transcribe
STT_HTTP_API_KEY=
STT_TIMEOUT_S=30
# STT service (stt_server.py): auto=local faster-whisper if installed else OpenAI if key is set
# STT_ENGINE=auto
# Optional cloud STT (good when local Whisper cannot install, e.g. Python 3.14+)
# Required for tts_server.py (OpenAI speech) as well
# OPENAI_API_KEY=

TTS_PROVIDER=http
TTS_HTTP_URL=http://127.0.0.1:9002/synthesize
TTS_HTTP_API_KEY=
TTS_TIMEOUT_S=30
# tts_server.py: OPENAI_TTS_VOICE=alloy, OPENAI_TTS_MODEL=tts-1
