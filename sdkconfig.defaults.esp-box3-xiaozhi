# Merged after sdkconfig.defaults and sdkconfig.defaults.${IDF_TARGET} (see root CMakeLists.txt).
# Espressif ESP-BOX-3 — defaults: built-in assets (so wake word + srmodels match sdkconfig),
# English Multinet custom wake "grace" -> display "Grace", device-side AEC.

# Board (choice: exactly one)
# CONFIG_BOARD_TYPE_BREAD_COMPACT_WIFI is not set
CONFIG_BOARD_TYPE_ESP_BOX_3=y

# Default chat UI (built-in assets include fonts/emojis; emote bundle was FLASH_CUSTOM before)
# CONFIG_USE_EMOTE_MESSAGE_STYLE is not set
# CONFIG_USE_WECHAT_MESSAGE_STYLE is not set
CONFIG_USE_DEFAULT_MESSAGE_STYLE=y

# Build assets.bin from sdkconfig (required for custom Multinet wake word index.json)
# CONFIG_FLASH_CUSTOM_ASSETS is not set
# CONFIG_FLASH_NONE_ASSETS is not set
# CONFIG_FLASH_EXPRESSION_ASSETS is not set
CONFIG_FLASH_DEFAULT_ASSETS=y

# English Multinet (required for English word "grace"; see Espressif ESP-SR Kconfig)
# CONFIG_SR_MN_EN_NONE is not set
CONFIG_SR_MN_EN_MULTINET7_QUANT=y

# Custom wake word: command string is what Multinet matches (lowercase typical for EN)
# CONFIG_USE_AFE_WAKE_WORD is not set
# CONFIG_USE_ESP_WAKE_WORD is not set
# CONFIG_WAKE_WORD_DISABLED is not set
CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_CUSTOM_WAKE_WORD="grace"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="Grace"
CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20

CONFIG_USE_AUDIO_PROCESSOR=y
CONFIG_USE_DEVICE_AEC=y
