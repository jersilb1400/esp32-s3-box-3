# Merged after sdkconfig.defaults and sdkconfig.defaults.${IDF_TARGET} (see root CMakeLists.txt).
# Espressif ESP-BOX-3 — full kit defaults: display style, assets, wake/AFE, device-side AEC.

# Board (choice: exactly one)
# CONFIG_BOARD_TYPE_BREAD_COMPACT_WIFI is not set
CONFIG_BOARD_TYPE_ESP_BOX_3=y

# Display: emote UI (recommended for BOX-3; enables expression asset path in build)
# CONFIG_USE_DEFAULT_MESSAGE_STYLE is not set
# CONFIG_USE_WECHAT_MESSAGE_STYLE is not set
CONFIG_USE_EMOTE_MESSAGE_STYLE=y

# Assets: official BOX-3 custom bundle (wake/font/emote). Requires network on first flash
# unless you download the file into the project and point CUSTOM_ASSETS_FILE to the path.
# CONFIG_FLASH_DEFAULT_ASSETS is not set
# CONFIG_FLASH_NONE_ASSETS is not set
# CONFIG_FLASH_EXPRESSION_ASSETS is not set
CONFIG_FLASH_CUSTOM_ASSETS=y
CONFIG_CUSTOM_ASSETS_FILE="https://dl.espressif.com/AE/wn9_nihaoxiaozhi_tts-font_puhui_common_20_4-esp-box-3.bin"

# Audio path used with BOX-3 + AFE wake word
CONFIG_USE_AFE_WAKE_WORD=y
CONFIG_USE_AUDIO_PROCESSOR=y
CONFIG_USE_DEVICE_AEC=y
